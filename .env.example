# Copy this file to .env only for local development. Do not commit .env.
# Paths may point only to data you are licensed to use.
# ASHARE_CSMAR_CACHE_DIR=/absolute/path/to/cache/csmar
# ASHARE_CSMAR_REFERENCE_DIR=/absolute/path/to/cache/csmar_reference
# ASHARE_RESEARCH_DB=/absolute/path/to/research.db

# MCP binds to loopback only. ChatGPT developer-mode testing needs a separate,
# temporary authenticated HTTPS tunnel; never put tunnel tokens in this file.
ASHARE_MCP_HOST=127.0.0.1
ASHARE_MCP_PORT=8765
ASHARE_MCP_TRANSPORT=streamable-http

# Fail-closed by default. Set true only after confirming that your data license
# permits derived research results to be processed by the connected model service.
ASHARE_MCP_ALLOW_LICENSED_DERIVED_RESULTS=false
