{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "A股助手：启动界面",
      "type": "process",
      "command": "/usr/bin/open",
      "args": ["http://127.0.0.1:8501"],
      "problemMatcher": []
    },
    {
      "label": "A股助手：运行本地服务",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "streamlit",
        "run",
        "${workspaceFolder}/src/ashare_lab/ui/A股研究室.py",
        "--server.address",
        "127.0.0.1",
        "--server.port",
        "8501"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "A股助手：运行测试",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "pytest"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "A股助手：安装依赖",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "pip",
        "install",
        "-e",
        ".[akshare,dev]"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
